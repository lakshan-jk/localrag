# Copy this file to ".env":   cp .env.example .env

# Which LLM to use for answers:
#   "ollama"   -> fully open-source, local, free, offline (default)
#   "anthropic"-> Claude (needs API key)
#   "openai"   -> GPT   (needs API key)
LLM_PROVIDER=ollama

# --- Ollama (open-source, local) ---
# Install from https://ollama.com, then:  ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# --- Cloud options (only if you change LLM_PROVIDER above) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Embeddings run locally and free (open-source). Downloads once on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Force HuggingFace's classic download path. Some networks block the newer Xet
# CDN (cas-server.xethub.hf.co); set this to 1 if model downloads hang/fail.
HF_HUB_DISABLE_XET=1

# Retrieval / chunking knobs — tune these and watch how answers change.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- Retrieval pipeline ---
# RETRIEVAL_MODE: "hybrid" (dense+MMR + BM25 fused with RRF) or "dense" (baseline).
RETRIEVAL_MODE=hybrid
# RERANK: re-score the fused candidates with a cross-encoder before answering.
RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Drop candidates below this re-rank score (blank = keep top-k regardless).
RERANK_MIN_SCORE=
# Candidate pool sizes before fusion, fused pool size, and MMR/RRF constants.
DENSE_CANDIDATES=20
BM25_CANDIDATES=20
FUSE_TOP=12
MMR_LAMBDA=0.5
RRF_K=60

DATA_DIR=data
INDEX_DIR=.index
